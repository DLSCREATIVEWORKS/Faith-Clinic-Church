# Faith Clinic Church static site
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

# One address for search engines: send faithclinicministries.org to
# https://www.faithclinicministries.org (SSL renewal files are left alone).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^faithclinicministries\.org$ [NC]
  RewriteRule ^(.*)$ https://www.faithclinicministries.org/$1 [R=301,L]
</IfModule>

# Long cache for versioned build files and images
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
</IfModule>
<FilesMatch "^_next/static/">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
