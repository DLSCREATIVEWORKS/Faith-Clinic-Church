{
  "name": "faith-clinic-church",
  "version": "1.0.0",
  "description": "Faith Clinic Church website (Next.js, exported as static files)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.cpSync('out','dist',{recursive:true})\"",
    "start": "npx --yes serve dist",
    "lint": "eslint ."
  },
  "dependencies": {
    "cross-env": "^7.0.3",
    "next": "16.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.4.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
